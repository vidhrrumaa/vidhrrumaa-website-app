# Base URL for the backend API. Leave unset to use a relative path (same-origin).
# In production, point this at the deployed API origin, e.g. https://api.vidhrrumaa.com/api/v1
VITE_API_BASE=/api/v1

# Cloudflare Turnstile site key (Contact/Careers forms). This is a public key,
# safe to ship in frontend code — the matching TURNSTILE_SECRET_KEY stays
# server-side only. Get both from dash.cloudflare.com → Turnstile → add a site.
VITE_TURNSTILE_SITE_KEY=
